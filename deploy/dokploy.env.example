# Template for the Dokploy application's Environment tab.
# Copy the values into Dokploy; never commit real secrets or a filled copy.
# See docs/DOKPLOY.md for the full walkthrough.

# Required. At least 32 random characters. Generate without printing it:
#   openssl rand -hex 32
PERKRADAR_ACCESS_TOKEN=

# Keep 1 behind Dokploy's HTTPS. Only set 0 for trusted plain-HTTP debugging.
PERKRADAR_SECURE_COOKIE=1

# Optional Jina credential used by the LINUX DO source.
JINA_API_KEY=

# Optional Telegram notifications. Both the token and the chat id are required;
# with either missing, no message is ever sent.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_MESSAGE_THREAD_ID=
# TELEGRAM_NOTIFY_FAILURES=1
# TELEGRAM_MAX_DEALS=10
# TELEGRAM_TIMEOUT_MS=8000
